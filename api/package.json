    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "mupdf": "^1.28.6",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
