# NSFWComix environment. Copy to .env and fill in. NEVER commit real values.
# Integration keys (R2, SendGrid, payments, reCAPTCHA) are entered in /admin and
# stored encrypted in the database, not here.

NODE_ENV=development
PORT=4000
# Address the API listens on. Defaults to 127.0.0.1 in production (nginx is the only way in).
# HOST=127.0.0.1
# Public origin of the site (no trailing slash)
APP_URL=http://localhost:5173

DATABASE_URL=postgres://nsfwcomix@localhost:5432/nsfwcomix

# 32+ random bytes, base64. Encrypts secrets saved from /admin and signs media URLs.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=

# Local disk storage root, used until R2 is configured in /admin
STORAGE_DIR=./storage

# The account registered with this email becomes super admin
SUPER_ADMIN_EMAIL=

# Shared secret for server-side cron and the firewall sync script
CRON_SECRET=
