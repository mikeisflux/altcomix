# Copy to /etc/default/botblock-watcher on the server:
#   sudo install -m 600 -o root -g root botblock.env.example /etc/default/botblock-watcher
# then fill it in THERE. Never commit real values.
#
# Plain KEY=value lines only (no quotes, no "export"): the file is read by
# both systemd and bash.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nsfwcomix
DB_USER=nsfwcomix

# Either set the password here (file must stay mode 600, owner root) ...
#DB_PASS=
# ... or leave it out and put a line in /root/.pgpass (mode 600):
#   127.0.0.1:5432:nsfwcomix:nsfwcomix:<password>

# Addresses that must never be dropped, space separated (office, monitoring).
#BOTBLOCK_ALLOWLIST=198.51.100.10 198.51.100.11
