[Unit]
Description=AltComix BotBlock watcher - instant firewall blocking for detected bots
After=network.target postgresql.service
Wants=network.target

[Service]
Type=simple
ExecStart=/bin/bash /usr/local/lib/botblock/botblock-watcher.sh
# Database connection settings (root-only file, never in the repository).
# The leading "-" lets the service start without it and use ~/.pgpass defaults.
EnvironmentFile=-/etc/default/botblock-watcher
Restart=always
RestartSec=5
StartLimitIntervalSec=0
StandardOutput=append:/var/log/botblock-watcher.log
StandardError=append:/var/log/botblock-watcher.log

[Install]
WantedBy=multi-user.target
